{
  "name": "messy",
  "version": "1.0.0",
  "description": "CLI tool to safe your files and documents",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky install",
    "test": "npm run build && node --test ./dist/__tests__/**/*.test.js",
    "test:coverage": "npm run build && c8 --100 --reporter=text --reporter=html node --expose-gc --test ./dist/__tests__/**/*.test.js",
    "cli": "npm run build && npm link",
    "build:prod": "rollup -c rollup.config.mjs"
  },
  "bin": {
    "messy": "./dist/index.js"
  },
  "keywords": [],
  "author": "Hritik Kumar Sinha",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "c8": "^10.1.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "rollup": "^4.50.1",
    "rollup-plugin-preserve-shebang": "^1.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "dependencies": {
    "jiti": "^2.5.1"
  }
}
